    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Condition="'$(OnnxRuntime)' == 'CPU'" Version="1.23.2" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Condition="'$(OnnxRuntime)' == 'Nvidia'" Version="1.27.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
